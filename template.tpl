___TESTS___

scenarios:
- name: Sets the global default with wait_for_update and loads the banner with the key
  code: |-
    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500
    });
    assertThat(injectedUrl).isEqualTo('https://cdn.arqam360.com/widget-v2.js?key=ciq_live_0123456789abcdef');
    assertApi('gtmOnSuccess').wasCalled();
- name: Sets one default per region row, upper-cased, skipping unset types
  code: |-
    mockData.regionDefaults = [
      { region: 'sa, ae', ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: '', ad_personalization: '', functionality_storage: '', personalization_storage: '', security_storage: '' },
      { region: 'us-ca', ad_storage: 'granted', analytics_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', functionality_storage: '', personalization_storage: '', security_storage: '' }
    ];

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'denied',
      region: ['SA', 'AE'],
      wait_for_update: 500
    });
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
      region: ['US-CA'],
      wait_for_update: 500
    });
- name: Never waits less than 500 ms for the banner
  code: |-
    mockData.waitForUpdate = '100';

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500
    });
- name: Keeps a longer wait_for_update
  code: |-
    mockData.waitForUpdate = '2000';

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 2000
    });
- name: Sets ads_data_redaction and url_passthrough
  code: |-
    mockData.adsDataRedaction = true;
    mockData.urlPassthrough = true;

    runCode(mockData);

    assertApi('gtagSet').wasCalledWith({ ads_data_redaction: true, url_passthrough: true });
- name: Passes the banner language in the script URL
  code: |-
    mockData.language = 'ar';

    runCode(mockData);

    assertThat(injectedUrl).isEqualTo('https://cdn.arqam360.com/widget-v2.js?key=ciq_live_0123456789abcdef&lang=ar');
- name: Applies a returning visitor's stored choice from the consent cookie
  code: |-
    mock('getCookieValues', (name) => {
      if (name === 'consentiq_consent') {
        return ['{"choices":{"necessary":true,"analytics":true,"marketing":false,"preferences":false},"version":"5.0.0"}'];
      }
      return [];
    });

    runCode(mockData);

    assertApi('updateConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'granted',
      personalization_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted'
    });
- name: Ignores an unreadable consent cookie
  code: |-
    mock('getCookieValues', () => ['not json']);

    runCode(mockData);

    assertApi('updateConsentState').wasNotCalled();
- name: Registers the update hook and applies banner updates through updateConsentState
  code: |-
    runCode(mockData);

    assertThat(updateHook).isFunction();
    updateHook({
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'granted',
      security_storage: 'granted',
      not_a_consent_type: 'granted'
    });

    assertApi('updateConsentState').wasCalledWith({
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'granted',
      security_storage: 'granted'
    });
- name: The update hook drops invalid values
  code: |-
    runCode(mockData);

    updateHook({ ad_storage: 'yes please', analytics_storage: 'denied' });
    assertApi('updateConsentState').wasCalledWith({ analytics_storage: 'denied' });
- name: The update hook ignores an empty update
  code: |-
    runCode(mockData);

    updateHook({ something_else: 'granted' });
    assertApi('updateConsentState').wasNotCalled();
- name: Reports failure when the banner script cannot load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => {
      onFailure();
    });

    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  let injectedUrl;
  let updateHook;

  mock('injectScript', (url, onSuccess, onFailure) => {
    injectedUrl = url;
    onSuccess();
  });

  mock('setInWindow', (key, value) => {
    if (key === 'arqam360GtmConsentUpdate') {
      updateHook = value;
    }
    return true;
  });

  const mockData = {
    siteKey: 'ciq_live_0123456789abcdef',
    adStorage: 'denied',
    adUserData: 'denied',
    adPersonalization: 'denied',
    analyticsStorage: 'denied',
    functionalityStorage: 'granted',
    personalizationStorage: 'denied',
    securityStorage: 'granted',
    waitForUpdate: '500',
    adsDataRedaction: false,
    urlPassthrough: false,
    language: '',
    regionDefaults: []
  };


