___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Arqam360 Consent Mode template.
//
// Order matters and follows Google's CMP template guidance
// (developers.google.com/tag-platform/tag-manager/templates/consent-apis):
//   1. gtagSet for ads_data_redaction / url_passthrough (and developer_id).
//   2. setDefaultConsentState: one global default + one per region row,
//      each with wait_for_update.
//   3. A returning visitor's stored choice is applied straight from the
//      consent cookie, so tags waiting on wait_for_update see it at once.
//   4. window.arqam360GtmConsentUpdate is registered BEFORE the banner loads.
//      widget-v2.js calls it on every consent change; it applies the change
//      through updateConsentState (never `gtag consent`), and its presence
//      tells the widget not to push its own consent default.
//   5. The banner is injected from cdn.arqam360.com with the site key.

const encodeUriComponent = require('encodeUriComponent');
const getCookieValues = require('getCookieValues');
const gtagSet = require('gtagSet');
const injectScript = require('injectScript');
const JSON = require('JSON');
const log = require('logToConsole');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const setDefaultConsentState = require('setDefaultConsentState');
const setInWindow = require('setInWindow');
const updateConsentState = require('updateConsentState');

// TODO(arqam360): Google issues a developer ID to CMP vendors. Once it has
// been issued, put it here (without the "developer_id." prefix) AND add
// "developer_id.<id>" to the write_data_layer permission. While it is empty
// the template sets no developer ID.
const DEVELOPER_ID = '';

const WIDGET_URL = 'https://cdn.arqam360.com/widget-v2.js';
const CONSENT_COOKIE = 'consentiq_consent';
const UPDATE_HOOK = 'arqam360GtmConsentUpdate';
const MIN_WAIT_FOR_UPDATE = 500;

const CONSENT_TYPES = [
  'ad_storage',
  'ad_user_data',
  'ad_personalization',
  'analytics_storage',
  'functionality_storage',
  'personalization_storage',
  'security_storage'
];

// Global default fields use lowerCamelCase names (template style guide);
// this maps each one to its Google consent type.
const GLOBAL_DEFAULT_FIELDS = {
  ad_storage: 'adStorage',
  ad_user_data: 'adUserData',
  ad_personalization: 'adPersonalization',
  analytics_storage: 'analyticsStorage',
  functionality_storage: 'functionalityStorage',
  personalization_storage: 'personalizationStorage',
  security_storage: 'securityStorage'
};

const isState = (value) => value === 'granted' || value === 'denied';

const waitForUpdate = () => {
  const ms = makeNumber(data.waitForUpdate);
  return ms >= MIN_WAIT_FOR_UPDATE ? ms : MIN_WAIT_FOR_UPDATE;
};

const parseRegions = (input) => {
  if (!input) return [];
  return makeString(input)
    .split(',')
    .map((entry) => entry.trim().toUpperCase())
    .filter((entry) => entry.length > 0);
};

// Only the seven known consent types with a valid value ever reach the
// consent APIs, whatever the page hands us.
const pickConsent = (source) => {
  const consent = {};
  let count = 0;
  if (!source) return null;
  CONSENT_TYPES.forEach((type) => {
    if (isState(source[type])) {
      consent[type] = source[type];
      count++;
    }
  });
  return count > 0 ? consent : null;
};

// Arqam360's stored categories → Google consent types. Necessary cookies
// (functionality, security) are always granted, as in the banner itself.
const fromChoices = (choices) => {
  if (!choices) return null;
  return {
    ad_storage: choices.marketing ? 'granted' : 'denied',
    ad_user_data: choices.marketing ? 'granted' : 'denied',
    ad_personalization: choices.marketing ? 'granted' : 'denied',
    analytics_storage: choices.analytics ? 'granted' : 'denied',
    personalization_storage: choices.preferences ? 'granted' : 'denied',
    functionality_storage: 'granted',
    security_storage: 'granted'
  };
};

const onConsentUpdate = (state) => {
  const consent = pickConsent(state);
  if (consent) {
    updateConsentState(consent);
    log('Arqam360: consent updated', consent);
  }
};

// 1. Optional Google tag settings.
gtagSet({
  ads_data_redaction: data.adsDataRedaction === true,
  url_passthrough: data.urlPassthrough === true
});
if (DEVELOPER_ID) {
  gtagSet('developer_id.' + DEVELOPER_ID, true);
}

// 2. Defaults: one for everyone, then one per region row.
const globalDefault = {};
CONSENT_TYPES.forEach((type) => {
  const value = data[GLOBAL_DEFAULT_FIELDS[type]];
  if (isState(value)) globalDefault[type] = value;
});
globalDefault.wait_for_update = waitForUpdate();
setDefaultConsentState(globalDefault);

(data.regionDefaults || []).forEach((row) => {
  const regions = parseRegions(row.region);
  if (regions.length === 0) return;
  const regionDefault = pickConsent(row) || {};
  regionDefault.region = regions;
  regionDefault.wait_for_update = waitForUpdate();
  setDefaultConsentState(regionDefault);
});

// 3. A returning visitor's choice, straight from the cookie.
const stored = getCookieValues(CONSENT_COOKIE);
if (stored && stored.length > 0) {
  const parsed = JSON.parse(stored[0]);
  if (parsed && parsed.choices) {
    onConsentUpdate(fromChoices(parsed.choices));
  }
}

// 4. Every later change, from the banner.
setInWindow(UPDATE_HOOK, onConsentUpdate, true);

// 5. Load the banner.
let url = WIDGET_URL + '?key=' + encodeUriComponent(makeString(data.siteKey).trim());
if (data.language) {
  url = url + '&lang=' + encodeUriComponent(data.language);
}
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'arqam360-widget');


